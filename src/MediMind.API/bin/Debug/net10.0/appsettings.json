{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mediminddb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_STRONG_256_BIT_SECRET_KEY_IN_PRODUCTION_MINIMUM_32_CHARS",
    "Issuer": "MediMind",
    "Audience": "MediMind",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "MlService": {
    "BaseUrl": "http://localhost:5001",
    "TimeoutSeconds": 30
  },
  "Chapa": {
    "SecretKey": "CHASECK_TEST-your-chapa-test-secret-key",
    "BaseUrl": "https://api.chapa.co/",
    "CallbackUrl": "http://localhost:5000/api/v1/payments/webhook",
    "ReturnUrl": "http://localhost:3000/payment/success"
  },
  "GeezsMS": {
    "ApiKey": "dummy-geezsms-api-key",
    "BaseUrl": "https://api.geezsms.com/",
    "SenderName": "MediMind"
  },
  "Firebase": {
    "ServiceAccountPath": "firebase-service-account.json",
    "ProjectId": "your-firebase-project-id"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "capacitor://localhost",
      "ionic://localhost"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "POST:/api/v1/auth/*",
        "Period": "5m",
        "Limit": 10
      }
    ]
  },
  "Hangfire": {
    "DashboardPath": "/hangfire"
  },
  "Authentication": {
    "TestOtp": {
      "Enabled": true,
      "Code": "000000"
    }
  },
  "AllowedHosts": "*"
}
