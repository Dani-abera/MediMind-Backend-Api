<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MediMind.API</RootNamespace>
    <UserSecretsId>medimind-api-secrets</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediMind.Application\MediMind.Application.csproj" />
    <ProjectReference Include="..\MediMind.Infrastructure\MediMind.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- OpenAPI document generation + Scalar UI (no Swashbuckle) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.13.22" />
    <!-- Rate limiting -->
    <PackageReference Include="AspNetCoreRateLimit" Version="5.*" />
    <!-- Serilog -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
    <PackageReference Include="Polly" Version="7.*" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.*" />
  </ItemGroup>

</Project>
